# ===================================
# PawnGold Integrated Management System
# Environment Configuration Template
# ===================================

# IMPORTANT: Copy this file to .env in both backend/ and frontend/ folders
# Fill in actual values for your deployment environment

# ===== BACKEND (.env in /backend) =====

# Database Connection (Supabase PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[SUPABASE_ID].supabase.co:5432/postgres

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URLs for CORS
# Single primary frontend URL
FRONTEND_URL=http://localhost:5173
# Auction landing/frontend URL
AUCTION_FRONTEND_URL=http://localhost:5174
# Optional mobile web origin (Flutter web/dev)
MOBILE_WEB_URL=http://localhost:7357
# Optional additional origins (comma-separated)
CORS_ALLOWED_ORIGINS=

# Supabase (backend service role + URL)
VITE_SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY_HERE]

# PayMongo (backend)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Security tuning (backend)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=250
BODY_LIMIT_MB=12
# Mail delivery (backend)
# Use SMTP_PROVIDER=gmail to force Gmail SMTP defaults.
SMTP_PROVIDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PawnGold Security
# Force IPv4 routing if host has broken IPv6 egress.
SMTP_IP_FAMILY=4
# Keep false to prevent hostname fallback to IPv6 routes.
SMTP_ALLOW_HOSTNAME_FALLBACK=false
# SMTP timeout tuning to prevent long signup delays on mail server issues
SMTP_CONNECTION_TIMEOUT_MS=7000
SMTP_GREETING_TIMEOUT_MS=7000
SMTP_SOCKET_TIMEOUT_MS=12000
# Controls whether SMTP hostnames are pre-resolved to IP candidates first.
# For Gmail on cloud hosts, keep false to use hostname transport directly.
SMTP_RESOLVE_IP_CANDIDATES=false
# Optional HTTPS email fallback (recommended on platforms that block SMTP ports)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=PawnGold Security
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=PawnGold Security
# Fail fast on startup when DB credentials are invalid/unreachable
DB_STRICT_STARTUP=true

# ===== FRONTEND (.env in /frontend) =====

# Supabase Configuration (from Supabase Dashboard)
# Get these from: https://supabase.com/dashboard/project/[PROJECT_ID]/settings/api
VITE_SUPABASE_URL=https://[PROJECT_ID].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR_ANON_KEY_HERE]
VITE_BACKEND_URL=http://localhost:3000

# ===== AUCTION FRONTEND (.env in /auction-frontend) =====
VITE_SUPABASE_URL=https://[PROJECT_ID].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR_ANON_KEY_HERE]
VITE_BACKEND_URL=http://localhost:3000

# ===== MOBILE (.env in /mobile) =====
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=[YOUR_ANON_KEY_HERE]
BACKEND_URL=http://localhost:3000

# ===== DEVELOPMENT ONLY =====

# Enable verbose logging in development
VITE_DEBUG=false

# ===== PRODUCTION DEPLOYMENT =====

# When deploying to production:
# 1. Set NODE_ENV=production in backend
# 2. Use production database with proper SSL
# 3. Set FRONTEND_URL/AUCTION_FRONTEND_URL/CORS_ALLOWED_ORIGINS to your domains
# 4. Use Supabase project keys securely
# 5. Never commit .env files to version control
# 6. Use environment variable management service (GitHub Secrets, AWS Secrets Manager, etc)

# ===== SECURITY CHECKLIST =====

# [ ] Database credentials are strong and rotated
# [ ] Supabase anon key has appropriate RLS policies
# [ ] CORS origins are restricted to known domains
# [ ] NODE_ENV is set to 'production' in prod
# [ ] All secrets are stored securely (not in .env)
# [ ] HTTPS is enforced in production
# [ ] Database backups are configured
# [ ] Rate limiting is enabled
# [ ] Monitoring and logging are set up
