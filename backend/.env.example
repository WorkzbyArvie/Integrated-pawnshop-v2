# Required for Phase 10.1 credential security. Must be a stable, high-entropy
# value of at least 32 characters. The backend refuses to boot without it.
#
# It HMACs MFA verification codes and session-bound assertions. Changing it
# invalidates every pending MFA challenge and every issued assertion, so keep it
# stable across restarts and identical on every instance. Never commit a real
# value.
MFA_CODE_HMAC_PEPPER=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# NOT optional for migrations. `npx prisma migrate deploy` reads this, and it is
# the value that fails with P1000 when the password has been rotated in Supabase
# without this file being updated. Render supplies its own, so the deployed
# service is unaffected; only local runs break.
#
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the URI form with the pooler host, and URL-encode any special characters
# in the password. After rotating the password in Supabase, update this too, or
# every local `migrate`/`seed`/`db execute` will fail with P1000.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Migrations: if one fails, the next deploy is blocked with P3018
# ---------------------------------------------------------------------------
# Prisma records a failed migration in `_prisma_migrations` with `finished_at`
# NULL, and then refuses to apply ANY later migration until that row is
# resolved. So correcting the SQL is not enough on its own.
#
# From a machine with a working DATABASE_URL:
#   npx prisma migrate resolve --rolled-back <migration_name>
#   npx prisma migrate deploy
#
# Without a working local credential, the equivalent in the Supabase SQL editor
# is a single statement - no shell and no password needed:
#
#   UPDATE _prisma_migrations
#   SET rolled_back_at = NOW()
#   WHERE migration_name = '<migration_name>' AND finished_at IS NULL;
#
# Check it first with a SELECT on the same predicate. `migrate reset` is
# destructive and must never be run against production.

