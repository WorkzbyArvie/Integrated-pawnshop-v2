  @@schema("public")
}

enum LeaveType {
  SICK_LEAVE
  VACATION_LEAVE
  EMERGENCY_LEAVE
  UNPAID_LEAVE
  @@schema("public")
}

model AttendanceRecord {
  id                String            @id @default(uuid()) @db.Uuid
  staffId           String            @map("staff_id") @db.Uuid
  pawnshopId        String            @map("pawnshop_id") @db.Uuid
  branchId          Int?              @map("branch_id")
  date              DateTime          @db.Date
  
  // Time tracking
  clockIn           DateTime?         @map("clock_in")
  clockOut          DateTime?         @map("clock_out")
  workHours         Float?            @map("work_hours")
  overtimeHours     Float?            @default(0) @map("overtime_hours")
  
  // Status
  status            AttendanceStatus  @default(PRESENT)
  isLate            Boolean           @default(false) @map("is_late")
  lateMinutes       Int?              @default(0) @map("late_minutes")
  
  // Leave management
  leaveType         LeaveType?        @map("leave_type")
  leaveReason       String?           @map("leave_reason")
  leaveApprovedBy   String?           @map("leave_approved_by") @db.Uuid
  
  // Geolocation verification
  clockInLocation   String?           @map("clock_in_location")  // lat,lng
  clockOutLocation  String?           @map("clock_out_location")
  
  // Audit
  notes             String?
  verifiedBy        String?           @map("verified_by") @db.Uuid
  verifiedAt        DateTime?         @map("verified_at")
  
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  pawnshop          Pawnshop          @relation(fields: [pawnshopId], references: [id], onDelete: Cascade)
  branch            Branch?           @relation(fields: [branchId], references: [id])
  
  @@unique([staffId, pawnshopId, date])
  @@index([pawnshopId, date])
  @@index([staffId, date])
  @@map("attendance_records")
  @@schema("public")
}

/// Per-staff work schedule configuration
model StaffSchedule {
  id            String   @id @default(uuid()) @db.Uuid
  staffId       String   @map("staff_id") @db.Uuid
  pawnshopId    String   @map("pawnshop_id") @db.Uuid

  // Shift times (stored as "HH:mm" strings, e.g. "08:00", "17:00")
  shiftStart    String   @default("08:00") @map("shift_start")
  shiftEnd      String   @default("17:00") @map("shift_end")

  // Working days (bitmask: Mon=1,Tue=2,Wed=4,Thu=8,Fri=16,Sat=32,Sun=64)
  workingDays   Int      @default(31) @map("working_days")  // Mon-Fri by default

  // Late threshold in minutes
  lateThreshold Int      @default(15) @map("late_threshold")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pawnshop      Pawnshop @relation(fields: [pawnshopId], references: [id], onDelete: Cascade)

  @@unique([staffId, pawnshopId])
  @@map("staff_schedules")
  @@schema("public")
}

enum PayslipStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
  @@schema("public")
}

model Payslip {
  id                String         @id @default(uuid()) @db.Uuid
  staffId           String         @map("staff_id") @db.Uuid
  pawnshopId        String         @map("pawnshop_id") @db.Uuid
  branchId          Int?           @map("branch_id")
  
  // Period
  periodStart       DateTime       @map("period_start") @db.Date
  periodEnd         DateTime       @map("period_end") @db.Date
  paymentDate       DateTime? @map("payment_date") @db.Date
  
  // Earnings
  baseSalary        Float          @map("base_salary")
  overtimePay       Float          @default(0) @map("overtime_pay")
  allowances        Float          @default(0)
  bonuses           Float          @default(0)
  grossPay          Float          @map("gross_pay")
  
  // Deductions
  tax               Float          @default(0)
  sss               Float          @default(0)
  philhealth        Float          @default(0)
  pagibig           Float          @default(0)
  lateDeductions    Float          @default(0) @map("late_deductions")
  otherDeductions   Float          @default(0) @map("other_deductions")
  totalDeductions   Float          @map("total_deductions")
  
  // Net pay
  netPay            Float          @map("net_pay")
  
  // Work summary
  daysWorked        Int            @map("days_worked")
  daysAbsent        Int            @default(0) @map("days_absent")
  daysLate          Int            @default(0) @map("days_late")
  overtimeHours     Float          @default(0) @map("overtime_hours")
  
  // Status & approval
  status            PayslipStatus  @default(DRAFT)
  approvedBy        String?        @map("approved_by") @db.Uuid
  approvedAt        DateTime?      @map("approved_at")
  paidBy            String?        @map("paid_by") @db.Uuid
  paidAt            DateTime?      @map("paid_at")
  
  // Document
  pdfUrl            String?        @map("pdf_url")
  notes             String?
  
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  
  pawnshop          Pawnshop       @relation(fields: [pawnshopId], references: [id], onDelete: Cascade)
  branch            Branch?        @relation(fields: [branchId], references: [id])
  
  @@unique([staffId, pawnshopId, periodStart, periodEnd])
  @@index([pawnshopId, status])
  @@index([staffId, periodStart])
  @@map("payslips")
  @@schema("public")
}

// ============================================================================
// SUBSCRIPTION SYSTEM
// ============================================================================

enum SubscriptionTier {
  FREE
  TRIAL
  BASIC
  PROFESSIONAL
  ENTERPRISE
  @@schema("public")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIAL
  @@schema("public")
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUALLY
  @@schema("public")
}

model Subscription {
  id                String              @id @default(uuid()) @db.Uuid
  pawnshopId        String              @map("pawnshop_id") @db.Uuid
  tier              SubscriptionTier
  status            SubscriptionStatus  @default(TRIAL)
  billingInterval   BillingInterval     @map("billing_interval")
  
  // Pricing
  price             Float
  currency          String              @default("PHP")
  
  // Period
  startDate         DateTime            @map("start_date")
  endDate           DateTime            @map("end_date")
  trialEndDate      DateTime?           @map("trial_end_date")
  cancelledAt       DateTime?           @map("cancelled_at")
  
  // Features & limits
  maxBranches       Int?                @map("max_branches")
  maxStaff          Int?                @map("max_staff")
  maxTransactions   Int?                @map("max_transactions_per_month")
  features          Json                @db.Json  // {"analytics": true, "api_access": true}
  
  // Billing
  lastBilledAt      DateTime?           @map("last_billed_at")
  nextBillingDate   DateTime            @map("next_billing_date")
  autoRenew         Boolean             @default(true) @map("auto_renew")

  @@index([pawnshopId])
  @@index([status])
  
  // Payment tracking
  paymentMethodId   String?             @map("payment_method_id")
  billingEmail      String?             @map("billing_email")
  
  // PayMongo integration
  paymongoSubscriptionId String?        @map("paymongo_subscription_id")
  paymongoCustomerId     String?        @map("paymongo_customer_id")
  paymongoPlanId         String?        @map("paymongo_plan_id")
  paymongoCheckoutUrl    String?        @map("paymongo_checkout_url")
  pendingTier            SubscriptionTier? @map("pending_tier")
  
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  
  pawnshop          Pawnshop            @relation(fields: [pawnshopId], references: [id], onDelete: Cascade)
  payments          SubscriptionPayment[]
  
  @@index([pawnshopId, status])
  @@index([nextBillingDate, status])
  @@map("subscriptions")
  @@schema("public")
}

model SubscriptionPayment {
  id                String      @id @default(uuid()) @db.Uuid
  subscriptionId    String      @map("subscription_id") @db.Uuid
  amount            Float
  currency          String      @default("PHP")
  status            String      // "pending", "completed", "failed", "refunded"
  
  // Payment details
  paymentMethod     String      @map("payment_method")
  paymentReference  String?     @map("payment_reference")
  transactionId     String?     @map("transaction_id")
  receiptUrl        String?     @map("receipt_url")
  
  // Dates
  billingDate       DateTime    @map("billing_date")
  paidAt            DateTime?   @map("paid_at")
  failedAt          DateTime?   @map("failed_at")
  failureReason     String?     @map("failure_reason")
  
  createdAt         DateTime    @default(now()) @map("created_at")
  
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  @@index([subscriptionId, status])
  @@map("subscription_payments")
  @@schema("public")
}

enum ComplianceDocType {
  DTI_REGISTRATION
  SEC_REGISTRATION
  MAYORS_PERMIT
  BIR_COR
  BSP_LICENSE
  AMLC_REGISTRATION
  GOVERNMENT_ID
  PROOF_OF_ADDRESS
  FIRE_SAFETY_CERT
  OCCUPANCY_PERMIT
  @@schema("public")
}

enum ComplianceDocStatus {
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  @@schema("public")
}

model PawnshopDocument {
  id              String             @id @default(uuid()) @db.Uuid
  pawnshopId      String?            @map("pawnshop_id") @db.Uuid
  registrationRequestId String?      @map("registration_request_id") @db.Uuid
  documentType    ComplianceDocType  @map("document_type")
  fileName        String             @map("file_name")
  fileUrl         String             @map("file_url")
  fileSize        Int?               @map("file_size")
  status          ComplianceDocStatus @default(UPLOADED)
  expiryDate      DateTime?          @map("expiry_date")
  rejectionReason String?            @map("rejection_reason")
  verifiedBy      String?            @map("verified_by") @db.Uuid
  verifiedAt      DateTime?          @map("verified_at")
  uploadedBy      String             @map("uploaded_by") @db.Uuid
  hasViewed       Boolean            @default(false) @map("has_viewed")
  viewedAt        DateTime?          @map("viewed_at")
