enum LedgerEntryType {
  DEBIT
  CREDIT
  @@schema("public")
}

enum LedgerCategory {
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  AUCTION_PAYMENT
  AUCTION_REFUND
  PENALTY_COLLECTION
  FEE_COLLECTION
  OPERATIONAL_EXPENSE
  SALARY_PAYMENT
  SUBSCRIPTION_PAYMENT
  CASH_IN
  CASH_OUT
  ADJUSTMENT
  @@schema("public")
}

model CashLedgerEntry {
  id                String          @id @default(uuid()) @db.Uuid
  pawnshopId        String          @map("pawnshop_id") @db.Uuid
  branchId          Int?            @map("branch_id")
  entryNumber       String          @map("entry_number")  // Sequential: "LEDGER-2026-00001"
  
  // Transaction details
  entryType         LedgerEntryType @map("entry_type")
  category          LedgerCategory
  amount            Float
  balanceBefore     Float           @map("balance_before")
  balanceAfter      Float           @map("balance_after")
  
  // References
  referenceType     String?         @map("reference_type")  // "LOAN", "AUCTION", "PAYMENT"
  referenceId       String?         @map("reference_id")
  
  // Metadata
  description       String
  performedBy       String          @map("performed_by") @db.Uuid
  counterparty      String?         // Customer ID or external entity
  paymentMethod     String?         @map("payment_method")
  receiptNumber     String?         @map("receipt_number")
  
