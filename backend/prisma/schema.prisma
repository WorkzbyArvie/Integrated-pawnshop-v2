generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

// Prisma schema mapped to existing Supabase DB (public schema)

model Branch {
  id                   Int                    @id @default(autoincrement())
  name                 String
  location             String
  pawnshopId           String?                @map("pawnshop_id") @db.Uuid
  ownerUserId          String?                @map("owner_user_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  isActive             Boolean                @default(true) @map("is_active")
  tickets              Ticket[]
  staff                Staff[]
  systemSettings       SystemSettings?
  queueTickets         QueueTicket[]
  cashLedgerEntries    CashLedgerEntry[]
  dailyReconciliations DailyReconciliation[]
  attendanceRecords    AttendanceRecord[]
  payslips             Payslip[]
  pawnshop             Pawnshop?              @relation(fields: [pawnshopId], references: [id])
  @@map("branch")
  @@schema("public")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  inventory Inventory[]
  auctionListings AuctionListing[]
  @@map("category")
  @@schema("public")
}

model Customer {
  id                String              @id @default(uuid()) @db.Uuid
  fullName          String              @map("full_name")
  contactNumber     String              @map("contact_number")
  address           String
  loyaltyTier       String              @map("loyaltytier") @default("Standard")
  tier              CustomerTier        @default(STANDARD) @map("tier")
  kycStatus         KycStatus           @default(NOT_SUBMITTED) @map("kyc_status")
  createdAt         DateTime            @map("created_at") @default(now())
  pawnshopId        String?             @map("pawnshop_id") @db.Uuid
  tickets           Ticket[]
  queueTickets      QueueTicket[]
  pawnshop          Pawnshop?           @relation(fields: [pawnshopId], references: [id])
  loanApplications  LoanApplication[]
  eligibilityChecks EligibilityCheck[]
  payments          Payment[]
  ratings           AuctionRating[]
  receipts          Receipt[]
  customerKyc       CustomerKyc?
  tierHistory       CustomerTierHistory[]
  @@index([pawnshopId])
  @@map("customer")
  @@schema("public")
}

model Inventory {
  id            Int      @id @default(autoincrement())
  categoryId    Int?     @map("categoryid")
  ticketId      Int?     @map("ticketid")
  isForAuction  Boolean  @map("isforauction") @default(false)
  auctionPrice  Float?   @map("auctionprice")
  category      Category? @relation(fields: [categoryId], references: [id])
  ticket        Ticket?   @relation(fields: [ticketId], references: [id])
  @@map("inventory")
  @@schema("public")
}

model AuctionListing {
  id              Int                       @id @default(autoincrement())
  ticketId        Int                       @unique @map("ticket_id")
  pawnshopId      String                    @map("pawnshop_id") @db.Uuid
  categoryId      Int?                      @map("category_id")
  title           String
  description     String?
  itemCondition   String?                 @map("item_condition")
  itemSpecifications String?              @map("item_specifications")
  provenanceDetails String?               @map("provenance_details")
  disclosureNotes String?                 @map("disclosure_notes")
  startingPrice   Float                     @map("starting_price")
  reservePrice    Float?                    @map("reserve_price")
  currentBid      Float                     @map("current_bid") @default(0)
  bidCount        Int                       @map("bid_count") @default(0)
  minBidIncrement Float                     @map("min_bid_increment") @default(100)
  bidExtensionMin Int                       @map("bid_extension_min") @default(5)
  status          AuctionStatus             @default(DRAFT)
  startAt         DateTime?                 @map("start_at")
  endAt           DateTime?                 @map("end_at")
  publishedAt     DateTime?                 @map("published_at")
  createdAt       DateTime                  @map("created_at") @default(now())
  updatedAt       DateTime                  @map("updated_at") @default(now())
  ownerType       ListingOwnerType?         @map("owner_type")
  ownerId         String?                   @map("owner_id") @db.Uuid

  ticket          Ticket                    @relation(fields: [ticketId], references: [id])
  pawnshop        Pawnshop                  @relation(fields: [pawnshopId], references: [id])
  category        Category?                 @relation(fields: [categoryId], references: [id])
  bids            AuctionBid[]
  images          AuctionImage[]
  payments        Payment[]
  ratings         AuctionRating[]
  compliance      AuctionWinnerCompliance?
  legalProofs     LegalProof[]

  @@map("auction_listings")
  @@schema("public")
}

model AuctionBid {
  id          Int      @id @default(autoincrement())
  listingId   Int      @map("listing_id")
  bidderId    String   @map("bidder_id") @db.Uuid
  amount      Float
  createdAt   DateTime @map("created_at") @default(now())

  listing     AuctionListing @relation(fields: [listingId], references: [id])
  legalProofs LegalProof[]

  @@index([listingId])
  @@map("auction_bids")
  @@schema("public")
}

model AuctionImage {
  id          Int      @id @default(autoincrement())
  listingId   Int      @map("listing_id")
  url         String
  sortOrder   Int      @map("sort_order") @default(0)
  createdAt   DateTime @map("created_at") @default(now())

  listing     AuctionListing @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@map("auction_images")
  @@schema("public")
}

model Loan {
  id                 Int                  @id @default(autoincrement())
  ticketId           Int?                 @map("ticketid")
  principalAmount    Float                @map("principalamount")
  interestAmount     Float                @map("interestamount")
  customerName       String?              @map("customername")
  category           String?
  weight             Decimal?
  riskScore          Decimal?             @map("riskscore")
  status             TicketLifecycleStatus @default(RECEIVED)
  pawnshopId         String?              @map("pawnshop_id") @db.Uuid
  createdAt          DateTime             @map("createdat") @default(now())
  applicationId      String?              @unique @map("application_id") @db.Uuid
  ticket             Ticket?              @relation(fields: [ticketId], references: [id])
  pawnshop           Pawnshop?            @relation(fields: [pawnshopId], references: [id])
  application        LoanApplication?     @relation("ApplicationToLoan", fields: [applicationId], references: [id])
  disbursements      LoanDisbursement[]
  schedules          RepaymentSchedule[]
  payments           Payment[]
  penalties          Penalty[]
  contract           LoanContract?
  legalProofs        LegalProof[]
  @@index([pawnshopId])
  @@index([status])
  @@index([pawnshopId, status])
  @@map("loan")
  @@schema("public")
}

model Pawnshop {
  id                        String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String                        @unique
  registrationNumber        String?                       @map("registration_number")
  taxId                     String?                       @map("tax_id") @unique
  address                   String?
  latitude                  Float?
  longitude                 Float?
  contactEmail              String?                       @map("contact_email")
  contactPhone              String?                       @map("contact_phone")
  logoUrl                   String?                       @map("logo_url")
  brandingId                Int?                          @map("branding_id")
  branding                  Branding?                     @relation(fields: [brandingId], references: [id])
  status                    String?                       @default("ACTIVE")
  ownerEmail                String?                       @map("owner_email")
  createdAt                 DateTime                      @map("created_at") @default(now())
  isActive                  Boolean?                      @map("is_active") @default(true)
  settings                  Json?                         @default("{}") @db.Json
  adminInvites              AdminInvite[]
  profiles                  Profile[]
  customers                 Customer[]
  tickets                   Ticket[]
  loans                     Loan[]
  branches                  Branch[]
  auctionListings           AuctionListing[]
  loanApplications          LoanApplication[]
  queueTickets              QueueTicket[]
  winnerCompliances         AuctionWinnerCompliance[]
  cashLedgerEntries         CashLedgerEntry[]
  dailyReconciliations      DailyReconciliation[]
  attendanceRecords         AttendanceRecord[]
  staffSchedules            StaffSchedule[]
  payslips                  Payslip[]
  subscriptions             Subscription[]
  legalProofs               LegalProof[]
  receipts                  Receipt[]
  legalEntity               LegalEntity?
  pawnshopDocuments         PawnshopDocument[]
  approvalRecords           ApprovalRecord[]
  customerKycRecords        CustomerKyc[]
  @@index([status])
  @@index([status, isActive])
  @@map("pawnshops")
  @@schema("public")

}

model Branding {
  id            Int      @id @default(autoincrement())
  name          String   // e.g. "Acme Pawnshop Branding"
  primaryColor  String?  // HEX or CSS color
  secondaryColor String? // HEX or CSS color
  accentColor   String?  // HEX or CSS color
  logoUrl       String?  // Custom logo for branding
  faviconUrl    String?  // Custom favicon
  theme         String?  // e.g. "light", "dark", "custom"
  customCss     String?  // Optional custom CSS
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  pawnshops     Pawnshop[]

  @@map("brandings")
  @@schema("public")
}

model Staff {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String   @map("full_name")
  password      String
  role          String   @default("STAFF")
  contactNumber String?  @map("contact_number")
  branchId      Int?     @map("branchid")
  branch        Branch?  @relation(fields: [branchId], references: [id])
  @@index([branchId])
  @@map("staff")
  @@schema("public")
}

model SystemSettings {
  id              Int    @id @default(autoincrement())
  branchId        Int    @unique @map("branchid")
  defaultInterest Float  @map("defaultinterest") @default(3.0)
  enableAiPricing Boolean @map("enableaipricing") @default(true)
  showVaultWidget Boolean @map("showvaultwidget") @default(true)
  showRiskWidget  Boolean @map("showriskwidget") @default(true)
  branch          Branch @relation(fields: [branchId], references: [id])
  @@map("systemsettings")
  @@schema("public")
}

model Ticket {
  id           Int      @id @default(autoincrement())
  ticketNumber String   @map("ticket_number") @unique
  customerId   String   @map("customer_id") @db.Uuid
  branchId     Int?     @map("branch_id")
  category     String
  description  String
  weight       Float?
  storageLocation String @map("storage_location") @default("Vault A")
  loanAmount   Float    @map("loan_amount")
  interestRate Float    @map("interest_rate") @default(3.0)
  status       String   @default("ACTIVE")
  lifecycleStatus TicketLifecycleStatus @default(RECEIVED) @map("lifecycle_status")
  isHighRisk   Boolean  @map("ishighrisk") @default(false)
  pawnDate     DateTime @map("pawn_date") @default(now())
  expiryDate   DateTime @map("expiry_date")
  forfeitureDate DateTime? @map("forfeituredate")
  gracePeriodEnd DateTime? @map("grace_period_end")
  pawnshopId   String?  @map("pawnshop_id") @db.Uuid
  contractId   String?  @map("contract_id") @db.Uuid
  updatedAt    DateTime @map("updatedat") @default(now())

  customer     Customer @relation(fields: [customerId], references: [id])
  branch       Branch?  @relation(fields: [branchId], references: [id])
  pawnshop     Pawnshop? @relation(fields: [pawnshopId], references: [id])
  loans        Loan[]
  inventory    Inventory[]
  transactions Transaction[]
  auctionListing AuctionListing?
  contract     LoanContract? @relation(fields: [contractId], references: [id])
  legalProofs  LegalProof[]
  @@index([pawnshopId])
  @@index([lifecycleStatus])
  @@index([status])
  @@index([pawnshopId, lifecycleStatus])
  @@index([pawnshopId, status])
  @@map("ticket")
  @@schema("public")
}

model Transaction {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  Int?     @map("ticketid")
  type      String
  amount    Float
  date      DateTime @default(now())
  staffName String   @map("staffname")
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  @@index([ticketId])
  @@map("transaction")
  @@schema("public")
}

model AdminInvite {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  pawnshopId String   @map("pawnshop_id") @db.Uuid
  role       String   @default("ADMIN")
  createdAt  DateTime @map("created_at") @default(now())
  pawnshop   Pawnshop @relation(fields: [pawnshopId], references: [id])
  @@index([pawnshopId])
  @@map("admin_invites")
  @@schema("public")
}

model Profile {
  id              String                   @id @db.Uuid
  role            String                   @default("STAFF")
  staffType       String?                  @map("staff_type")
  pawnshopId      String?                  @map("pawnshop_id") @db.Uuid
  createdAt       DateTime                 @map("created_at") @default(now())
  updatedAt       DateTime                 @map("updated_at") @default(now())
  email           String?
  fullName        String?                  @map("full_name")
  branchId        String?                  @map("branch_id") @db.Uuid
  isOnline        Boolean                  @map("is_online") @default(false)
  lastSeenAt      DateTime?                @map("last_seen_at")
  avatarUrl       String?                  @map("avatar_url")
  phoneNumber     String?                  @map("phone_number")
  address         String?
  dateOfBirth     DateTime?                @map("date_of_birth")
  pawnshop        Pawnshop?                @relation(fields: [pawnshopId], references: [id])
  approvals       LoanApproval[]
  kyc             BidderKyc?
  paymentMethods  CustomerPaymentMethod[]
  securityLogs    SecurityLog[]
  tosAcceptances  TOSAcceptance[]
  approvalRequests  ApprovalRecord[]       @relation("ApprovalRequestedBy")
  approvalDecisions ApprovalRecord[]       @relation("ApprovalDecidedBy")
  @@index([pawnshopId])
  @@index([role])
  @@index([pawnshopId, role])
  @@map("profiles")
  @@schema("public")
}

model CustomerPaymentMethod {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  type         String   // CARD, GCASH, PAYMAYA, BANK_ACCOUNT
  label        String?
  last4        String?
  cardBrand    String?  @map("card_brand")
  expiryMonth  Int?     @map("expiry_month")
  expiryYear   Int?     @map("expiry_year")
  bankName     String?  @map("bank_name")
  walletPhone  String?  @map("wallet_phone")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
  @@map("customer_payment_methods")
  @@schema("public")
}

model SecurityLog {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @map("profile_id") @db.Uuid
  action      String
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  success     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, createdAt])
  @@map("security_logs")
  @@schema("public")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  staffId   String   @map("staffid") @db.Uuid
  action    String
  details   String
  timestamp DateTime @default(now())
  @@index([staffId])
  @@index([timestamp])
  @@map("activitylog")
  @@schema("public")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OWNER
  MANAGER
  HR
  STAFF
  APPROVER
  @@schema("public")
}

enum TicketStatus {
  ACTIVE
  REDEEMED
  OVERDUE
  FORFEITED
  SOLD
  @@schema("public")
}

enum TicketLifecycleStatus {
  RECEIVED
  APPRAISED
  PENDING_APPROVAL
  OFFER_MADE
  CONTRACT_SIGNED
  DISBURSED
  ACTIVE
  GRACE_PERIOD
  OVERDUE
  REDEMPTION_PENDING_APPROVAL
  REDEEMED
  FORFEITED
  AUCTION_QUEUED
  AUCTION_SOLD
  AUCTION_UNSOLD
  CANCELLED
  @@schema("public")
}

enum ContractType {
  LOAN_CONTRACT
  AUCTION_BIDDER_AGREEMENT
  TERMS_OF_SERVICE
  CONSENT_FORM
  REDEMPTION_RECEIPT
  PRIVACY_POLICY
  @@schema("public")
}

enum ReceiptType {
  PAYMENT
  REDEMPTION
  LOAN_DISBURSEMENT
  AUCTION_SALE
  PENALTY
  RENEWAL
  SERVICE_FEE
  APPRAISAL_CERTIFICATE
  FORFEITURE
  AUCTION_UNSOLD
  @@schema("public")
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  @@schema("public")
}

// ============================================================================
// LOAN MANAGEMENT SYSTEM ENUMS (Added Feb 15, 2026)
// ============================================================================

enum ApplicationStatus {
  PENDING
  DOCUMENTS_REVIEW
  ELIGIBILITY_CHECK
  AWAITING_APPROVAL
  MANAGER_REVIEW
  OWNER_APPROVAL
  ADDITIONAL_PROOF
  APPROVED
  REJECTED
  DISBURSED
  @@schema("public")
}

enum DocumentType {
  VALID_ID
  PROOF_OF_INCOME
  PROOF_OF_RESIDENCE
  COLLATERAL_DOCUMENT
  BUSINESS_PERMIT
  BANK_STATEMENT
  OTHER
  @@schema("public")
}

enum ApproverRole {
  STAFF
  MANAGER
  OWNER
  @@schema("public")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REQUEST_MORE_INFO
  @@schema("public")
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  WAIVED
  @@schema("public")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  E_WALLET
  CHECK
  @@schema("public")
}

enum PaymentType {
  LOAN_REPAYMENT
  AUCTION_PAYMENT
  PENALTY_FEE
  SERVICE_FEE
  OTHER
  @@schema("public")
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  @@schema("public")
}

enum PenaltyType {
  LATE_PAYMENT
  MISSED_PAYMENT
  EARLY_TERMINATION
  DOCUMENTATION_FEE
  OTHER
  @@schema("public")
}

enum RatingType {
  ITEM_QUALITY
  TRANSACTION_EXPERIENCE
  SELLER_RATING
  @@schema("public")
}

enum ListingOwnerType {
  PAWNSHOP
  CUSTOMER
  @@schema("public")
}

// ============================================================================
// LOAN MANAGEMENT SYSTEM MODELS (Added Feb 15, 2026)
// ============================================================================

model LoanApplication {
  id                String              @id @default(uuid()) @db.Uuid
  customerId        String              @map("customer_id") @db.Uuid
  pawnshopId        String              @map("pawnshop_id") @db.Uuid
  loanAmount        Float               @map("loan_amount")
  loanType          String              @map("loan_type")
  termMonths        Int                 @map("term_months")
  purpose           String
  status            ApplicationStatus   @default(PENDING)
  submittedAt       DateTime            @default(now()) @map("submitted_at")
  evaluatedBy       String?             @map("evaluated_by") @db.Uuid
  evaluatedAt       DateTime?           @map("evaluated_at")
  approvedBy        String?             @map("approved_by") @db.Uuid
  approvedAt        DateTime?           @map("approved_at")
  rejectionReason   String?             @map("rejection_reason")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  
  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pawnshop          Pawnshop            @relation(fields: [pawnshopId], references: [id], onDelete: Cascade)
  documents         LoanDocument[]
  approvals         LoanApproval[]
  eligibilityCheck  EligibilityCheck?
  disbursement      LoanDisbursement[]
  loan              Loan?               @relation("ApplicationToLoan")
  contract          LoanContract?
  legalProofs       LegalProof[]
  
  @@index([pawnshopId])
  @@index([customerId])
  @@index([status])
  @@map("loan_applications")
  @@schema("public")
}

model LoanDocument {
  id                String        @id @default(uuid()) @db.Uuid
  applicationId     String        @map("application_id") @db.Uuid
  documentType      DocumentType  @map("document_type")
  fileName          String        @map("file_name")
  fileUrl           String        @map("file_url")
  fileSize          Int           @map("file_size")
  mimeType          String        @map("mime_type")
  uploadedAt        DateTime      @default(now()) @map("uploaded_at")
  uploadedBy        String        @map("uploaded_by") @db.Uuid
  verified          Boolean       @default(false)
  verifiedBy        String?       @map("verified_by") @db.Uuid
  verifiedAt        DateTime?     @map("verified_at")
  notes             String?
  
  application       LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@index([applicationId])
  @@map("loan_documents")
  @@schema("public")
}

model LoanApproval {
  id                      String            @id @default(uuid()) @db.Uuid
  applicationId           String            @map("application_id") @db.Uuid
  approverRole            ApproverRole      @map("approver_role")
  approverId              String            @map("approver_id") @db.Uuid
  decision                ApprovalDecision
  comments                String?
  additionalProofRequired Boolean           @default(false) @map("additional_proof_required")
  additionalProofNotes    String?           @map("additional_proof_notes")
  approvedAt              DateTime          @default(now()) @map("approved_at")
  
  application             LoanApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  approver                Profile           @relation(fields: [approverId], references: [id], onDelete: Cascade)
  
  @@index([applicationId])
  @@index([approverId])
  @@map("loan_approvals")
  @@schema("public")
}

model EligibilityCheck {
  id                String          @id @default(uuid()) @db.Uuid
  applicationId     String          @unique @map("application_id") @db.Uuid
  customerId        String          @map("customer_id") @db.Uuid
  creditScore       Int?            @map("credit_score")
  hasPreviousLoans  Boolean         @map("has_previous_loans")
  previousLoanCount Int             @default(0) @map("previous_loan_count")
  defaultHistory    Boolean         @default(false) @map("default_history")
  incomeVerified    Boolean         @default(false) @map("income_verified")
  monthlyIncome     Float?          @map("monthly_income")
  debtToIncomeRatio Float?          @map("debt_to_income_ratio")
  employmentStatus  String?         @map("employment_status")
  eligible          Boolean
  eligibilityNotes  String?         @map("eligibility_notes")
  checkedAt         DateTime        @default(now()) @map("checked_at")
  checkedBy         String          @map("checked_by") @db.Uuid
  
  application       LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  @@index([customerId])
  @@map("eligibility_checks")
  @@schema("public")
}

model LoanDisbursement {
  id                  String          @id @default(uuid()) @db.Uuid
  loanId              Int             @map("loan_id")
  applicationId       String          @map("application_id") @db.Uuid
  amount              Float
  disbursementMethod  String          @map("disbursement_method")
  referenceNumber     String?         @map("reference_number")
  disbursedBy         String          @map("disbursed_by") @db.Uuid
  disbursedAt         DateTime        @default(now()) @map("disbursed_at")
  receivedBy          String          @map("received_by") @db.Uuid
  receiptUrl          String?         @map("receipt_url")
  notes               String?
  
  loan                Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  application         LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  @@index([loanId])
  @@map("loan_disbursements")
  @@schema("public")
}

enum ProofRecordType {
  APPLICATION_SUBMITTED
  CONTRACT_PROOF
  PAYMENT_PROOF
  REPAYMENT_PROOF
  PENALTY_PROOF
  LEDGER_ENTRY_PROOF
  AUCTION_SETTLEMENT_PROOF
  RECEIPT_PROOF
  BIDDER_AGREEMENT_PROOF
  TOS_ACCEPTANCE_PROOF
  REDEMPTION_PROOF
  DISBURSEMENT_PROOF
  FORFEITURE_PROOF
  GRACE_PERIOD_ENTRY
  AUCTION_UNSOLD_PROOF
  AUCTION_SELLER_PROOF
  AUCTION_LISTING_PROOF
  AUCTION_PUBLISH_PROOF
  AUCTION_BID_PROOF
  @@schema("public")
}

model LegalProof {
  id              String          @id @default(uuid()) @db.Uuid
  proofNumber     String          @unique @map("proof_number")
  pawnshopId      String          @map("pawnshop_id") @db.Uuid
  recordType      ProofRecordType  @map("record_type")
  title           String
  summary         String
  payload         Json            @db.Json
  sourceHash      String          @map("source_hash")
  createdBy       String          @map("created_by") @db.Uuid
  applicationId   String?         @map("application_id") @db.Uuid
  loanId          Int?            @map("loan_id")
  paymentId       String?         @map("payment_id") @db.Uuid
  ledgerEntryId   String?         @map("ledger_entry_id") @db.Uuid
  ticketId        Int?            @map("ticket_id")
  contractId      String?         @map("contract_id") @db.Uuid
  auctionListingId Int?            @map("auction_listing_id")
  auctionBidId    Int?            @map("auction_bid_id")
  receiptId       String?         @map("receipt_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")

  pawnshop        Pawnshop        @relation(fields: [pawnshopId], references: [id], onDelete: Cascade)
  application     LoanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  loan            Loan?           @relation(fields: [loanId], references: [id], onDelete: SetNull)
  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  ledgerEntry     CashLedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  ticket          Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  contract        LoanContract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  auctionListing   AuctionListing? @relation(fields: [auctionListingId], references: [id], onDelete: SetNull)
  auctionBid       AuctionBid?     @relation(fields: [auctionBidId], references: [id], onDelete: SetNull)
  receipt          Receipt?        @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([pawnshopId, recordType, createdAt])
  @@index([applicationId])
  @@index([loanId])
  @@index([paymentId])
  @@index([ledgerEntryId])
  @@index([ticketId])
  @@index([contractId])
  @@index([auctionListingId])
  @@index([auctionBidId])
  @@index([receiptId])
  @@map("legal_proofs")
  @@schema("public")
}

model RepaymentSchedule {
