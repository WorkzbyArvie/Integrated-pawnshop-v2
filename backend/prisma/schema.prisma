  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  profile         Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("bidder_kyc")
  @@schema("public")
}

// ============================================================================
// QUEUE SYSTEM (Multi-tenant with pawnshop isolation)
// ============================================================================

enum QueueStatus {
  WAITING
  SERVING
  COMPLETED
  CANCELLED
  NO_SHOW
  @@schema("public")
}

enum QueueType {
  PAWNING
  RENEWAL
  REDEMPTION
  AUCTION_INQUIRY
  GENERAL
  @@schema("public")
}

model QueueTicket {
  id              String       @id @default(uuid()) @db.Uuid
  queueNumber     String       @map("queue_number")  // e.g., "P001", "R005"
  pawnshopId      String       @map("pawnshop_id") @db.Uuid
  branchId        Int?         @map("branch_id")
  customerId      String       @map("customer_id") @db.Uuid
  queueType       QueueType    @map("queue_type")
  status          QueueStatus  @default(WAITING)
  priority        Int          @default(0)         // 0=normal, 1=priority, 2=urgent
  estimatedWaitMinutes Int?    @map("estimated_wait_minutes")
  
  // Timestamps
  joinedAt        DateTime     @default(now()) @map("joined_at")
  calledAt        DateTime?    @map("called_at")
  servedAt        DateTime?    @map("served_at")
  completedAt     DateTime?    @map("completed_at")
  
  // Staff assignment
  assignedStaffId String?      @map("assigned_staff_id") @db.Uuid
  counterNumber   String?      @map("counter_number")
  
  // Metadata
  notes           String?
  metadata        Json?        @db.Json  // Custom data per pawnshop
  
  pawnshop        Pawnshop     @relation(fields: [pawnshopId], references: [id], onDelete: Cascade)
  branch          Branch?      @relation(fields: [branchId], references: [id])
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages        TicketMessage[]
  
  @@unique([pawnshopId, queueNumber])
  @@index([pawnshopId, status, joinedAt])
  @@index([customerId, status])
  @@index([pawnshopId, queueType, joinedAt])
  @@index([customerId, joinedAt])
  @@map("queue_tickets")
  @@schema("public")
}

