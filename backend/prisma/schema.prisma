  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  pawnshop        Pawnshop?          @relation(fields: [pawnshopId], references: [id], onDelete: Cascade)

  @@index([pawnshopId, documentType])
  @@index([pawnshopId, status])
  @@index([status])
  @@index([registrationRequestId])
  @@map("pawnshop_documents")
  @@schema("public")
}

model TenantAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  pawnshopId   String   @map("pawnshop_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([pawnshopId, createdAt])
  @@map("tenant_audit_logs")
  @@schema("public")
}

model ClientRegistrationRequest {
  id              String   @id @default(uuid()) @db.Uuid
  pawnshopName    String   @map("pawnshop_name")
  ownerName       String   @map("owner_name")
  ownerEmail      String   @map("owner_email")
  contactNumber   String?  @map("contact_number")
  selectedModules Json?    @map("selected_modules")
  staffCount      Int?     @default(1) @map("staff_count")
  notes           String?
  status          String   @default("PENDING")
  handledBy       String?  @map("handled_by") @db.Uuid
  handledAt       DateTime? @map("handled_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  messages ClientRegistrationMessage[]

  @@index([status, createdAt])
  @@map("client_registration_requests")
  @@schema("public")
}

model ClientRegistrationMessage {
  id           String   @id @default(uuid()) @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  senderUserId String?  @map("sender_user_id") @db.Uuid
  senderType   String   @map("sender_type")
  message      String
  createdAt    DateTime @default(now()) @map("created_at")

  request ClientRegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("client_registration_messages")
  @@schema("public")
}

model SupportChatConversation {
  id            String   @id @default(uuid()) @db.Uuid
  pawnshopId    String   @map("pawnshop_id") @db.Uuid
  subject       String
  status        String   @default("OPEN")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  messages SupportChatMessage[]

  @@index([pawnshopId, lastMessageAt])
  @@map("support_chat_conversations")
  @@schema("public")
}

model SupportChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  pawnshopId     String   @map("pawnshop_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  senderRole     String   @map("sender_role")
  message        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation SupportChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("support_chat_messages")
  @@schema("public")
}

// ============================================================================
// Phase 7: Permission catalog + v2.0 schema baseline (additive only)
// ============================================================================

enum CustomerTier {
  STANDARD
  BRONZE
  SILVER
  GOLD
  VIP
  @@schema("public")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  @@schema("public")
}

enum ApprovalTargetType {
  APPRAISAL
  REDEMPTION
  LOAN_APPLICATION
  LISTING_EDIT
  @@schema("public")
}

enum SignatureType {
  CANVAS
  TYPED
  UPLOADED
  @@schema("public")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  group           String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("public")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  role         String
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
  @@schema("public")
}

model ApprovalRecord {
  id              String             @id @default(uuid()) @db.Uuid
  pawnshopId      String             @map("pawnshop_id") @db.Uuid
  targetType      ApprovalTargetType @map("target_type")
  targetId        String             @map("target_id")
  status          ApprovalStatus     @default(PENDING)
  amount          Float?
  requestedById   String             @map("requested_by_id") @db.Uuid
  decidedById     String?            @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?          @map("decided_at")
  decisionComment String?            @map("decision_comment")
  payload         Json?              @map("payload")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  pawnshop        Pawnshop           @relation(fields: [pawnshopId], references: [id])
  requestedBy     Profile            @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy       Profile?           @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@index([pawnshopId, status])
  @@index([targetType, targetId])
  @@index([pawnshopId, status, createdAt])
  @@map("approval_records")
  @@schema("public")
}

model CustomerKyc {
  id               String     @id @default(uuid()) @db.Uuid
  customerId       String     @unique @map("customer_id") @db.Uuid
  pawnshopId       String     @map("pawnshop_id") @db.Uuid
  status           KycStatus  @default(NOT_SUBMITTED)
  fullName         String     @map("full_name")
  contactNumber    String     @map("contact_number")
  address          String
  idType           KycIdType  @map("id_type")
  idNumber         String     @map("id_number")
  idFrontUrl       String     @map("id_front_url")
  idBackUrl        String?    @map("id_back_url")
  selfieUrl        String?    @map("selfie_url")
  verificationData Json?      @map("verification_data")
  reviewedBy       String?    @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?  @map("reviewed_at")
  rejectionReason  String?    @map("rejection_reason")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  customer         Customer   @relation(fields: [customerId], references: [id])
  pawnshop         Pawnshop   @relation(fields: [pawnshopId], references: [id])

  @@index([pawnshopId, status])
  @@map("customer_kyc")
  @@schema("public")
}

model CustomerTierHistory {
  id          String        @id @default(uuid()) @db.Uuid
  customerId  String        @map("customer_id") @db.Uuid
  fromTier    CustomerTier? @map("from_tier")
  toTier      CustomerTier  @map("to_tier")
  reason      String
  changedById String?       @map("changed_by_id") @db.Uuid
  changedAt   DateTime      @default(now()) @map("changed_at")

  customer    Customer      @relation(fields: [customerId], references: [id])

  @@index([customerId, changedAt])
  @@map("customer_tier_history")
  @@schema("public")
}
