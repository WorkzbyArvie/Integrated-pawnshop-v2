// TICKET CHAT SYSTEM
// ============================================================================

enum MessageSenderRole {
  CUSTOMER
  STAFF
  APPROVER
  @@schema("public")
}

model TicketMessage {
  id         String            @id @default(uuid()) @db.Uuid
  ticketId   String            @map("ticket_id") @db.Uuid
  senderId   String            @map("sender_id") @db.Uuid
  senderRole MessageSenderRole @map("sender_role")
  message    String
