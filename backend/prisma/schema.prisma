enum ComplianceStatus {
  PENDING_COMPLIANCE
  REMINDER_SENT
  COMPLIED
  READY_FOR_RELEASE
  RELEASED
  EXPIRED
  REFUNDED
  @@schema("public")
}

model AuctionWinnerCompliance {
  id                  String            @id @default(uuid()) @db.Uuid
  listingId           Int               @unique @map("listing_id")
  winnerId            String            @map("winner_id") @db.Uuid
  pawnshopId          String            @map("pawnshop_id") @db.Uuid
  winningBid          Float             @map("winning_bid")
  status              ComplianceStatus  @default(PENDING_COMPLIANCE)
  
  // Deadline management
  complianceDeadline  DateTime          @map("compliance_deadline")
  reminderSentAt      DateTime?         @map("reminder_sent_at")
  lastReminderAt      DateTime?         @map("last_reminder_at")
  reminderCount       Int               @default(0) @map("reminder_count")
  
  // Compliance actions
  compliedAt          DateTime?         @map("complied_at")
  paymentProofUrl     String?           @map("payment_proof_url")
  paymentReference    String?           @map("payment_reference")
  verifiedBy          String?           @map("verified_by") @db.Uuid
  verifiedAt          DateTime?         @map("verified_at")
  
  // Release tracking
  releasedAt          DateTime?         @map("released_at")
  releasedBy          String?           @map("released_by") @db.Uuid
  releaseNotes        String?           @map("release_notes")
  
  // Expiry handling
  expiredAt           DateTime?         @map("expired_at")
  expiryAction        String?           @map("expiry_action")  // "REQUEUE", "NEXT_BIDDER"
  
  // Winner information (cached for pawnshop access)
  winnerFullName      String            @map("winner_full_name")
  winnerEmail         String?           @map("winner_email")
  winnerPhone         String            @map("winner_phone")
  winnerAddress       String?           @map("winner_address")
  
  // Contract signing
  contractSignedAt    DateTime?         @map("contract_signed_at")
  signedName          String?           @map("signed_name")

  // Privacy & audit
  accessLog           Json[]            @default([]) @map("access_log") @db.Json
  consentAcceptedAt   DateTime?         @map("consent_accepted_at")
  
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  
  listing             AuctionListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
