  readAt     DateTime?         @map("read_at")

  ticket     QueueTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
  @@schema("public")
}

