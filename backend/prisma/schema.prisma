// ============================================================================
// KYC (Know Your Customer) for Bidders
// ============================================================================

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
  @@schema("public")
}

enum KycIdType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  SSS_ID
  PHILHEALTH_ID
  TIN_ID
  VOTERS_ID
  POSTAL_ID
  OTHER
  @@schema("public")
}

model BidderKyc {
  id              String     @id @default(uuid()) @db.Uuid
  profileId       String     @unique @map("profile_id") @db.Uuid
  status          KycStatus  @default(NOT_SUBMITTED)

  // Personal details
  fullName        String     @map("full_name")
  dateOfBirth     DateTime   @map("date_of_birth")
  address         String
  phoneNumber     String     @map("phone_number")

  // ID verification
  idType          KycIdType  @map("id_type")
  idNumber        String     @map("id_number")
  idFrontUrl      String     @map("id_front_url")
  idBackUrl       String?    @map("id_back_url")
  selfieUrl       String     @map("selfie_url")

  // Client-side verification results (advisory — admin is the security gate)
  verificationData Json?     @map("verification_data")

  // Admin review
  reviewedBy      String?    @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?  @map("reviewed_at")
